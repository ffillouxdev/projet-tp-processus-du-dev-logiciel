# Secret key used for signing JWT tokens (generate a strong key with `openssl rand -hex 32`)
SECRET_KEY=replace_with_a_super_secret_key_at_least_32_characters_long

# JWT Algorithm (default: HS256)
ALGORITHM=HS256

# Token expiration times
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database connection URL
# Local default (SQLite):
DATABASE_URL=sqlite:///./tournament.db
# PostgreSQL (Production / Docker):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/tournament_db

# Environment
ENVIRONMENT=development

# Allowed CORS origins (JSON array or comma-separated list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:5173"]

